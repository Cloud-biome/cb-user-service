# AWS credentials — used locally; CI/CD uses OIDC (no stored keys)
AWS_PROFILE=default
AWS_REGION=us-east-1

# Injected by Terraform into the EKS pod at deploy time.
# Do NOT set these manually — listed here for documentation only.
DYNAMODB_TABLE_NAME=cb-user-service-dev-users

# GitHub Actions secrets (configure in repo Settings → Secrets)
# AWS_DEPLOY_ROLE_ARN  — IAM role ARN for OIDC federation
#                        e.g. arn:aws:iam::123456789012:role/github-deploy-role
# AWS_REGION           — Target AWS region, e.g. us-east-1
# ECR_REPOSITORY       — ECR repository name, e.g. cb-user-service-dev
